---
import "@/styles/global.css";
import Navbar from "@/components/astro/Navbar.astro";
import Footer from "@/components/astro/Footer.astro";
import faviconUrl from "../assets/65e216f69648d4dbccf8e3a5_vonfalk-favicon.png?url";

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><link rel="icon" href={faviconUrl} type="image/png" /><title>{title} | Von Falk</title><meta name="description" content="Von Falk interior studio" /><meta property="og:title" content={title} /><meta property="og:type" content="website" /><meta name="twitter:card" content="summary_large_image" /></head><body><div class="page-wrapper"><Navbar /><main><slot /></main><Footer /></div></body></html>
