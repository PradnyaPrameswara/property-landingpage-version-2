---
import type { Project } from "../../data/projects";
interface Props { project: Project }
const { project } = Astro.props;
---
<a class="vf-project-card" href={"/project/" + project.slug} aria-label={"View " + project.title + " project"}>
  <div class="vf-project-card-media">
    <img src={project.cover} alt={project.coverAlt} loading="eager" decoding="async" width="900" height="1125" />
  </div>
  <div class="vf-project-card-caption">
    <span>{project.title}.</span>
    <span>{project.city}.</span>
  </div>
</a>
