---
import mainLogoUrl from "../../assets/65e217e6568115217fe51b9e_main-logo.svg?url";
import MobileMenu from "../react/MobileMenu.tsx";

const links = [
  { href: "/", label: "Home." },
  { href: "/about-us", label: "About Us." },
  { href: "/projects", label: "Projects." },
  { href: "/services", label: "Services." },
  { href: "/team", label: "Team." },
  { href: "/blog", label: "Blog." },
  { href: "/contact", label: "Contact." },
];
const pathname = Astro.url.pathname;
---
<header class="vf-header">
  <div class="vf-container vf-header-inner">
    <span aria-hidden="true"></span>
    <a class="vf-header-logo" href="/" aria-label="Von Falk home">
      <img src={mainLogoUrl} alt="Von Falk." width="260" height="76" />
    </a>
    <div class="vf-header-actions">
      <MobileMenu links={links} currentPath={pathname} client:load />
    </div>
  </div>
</header>
