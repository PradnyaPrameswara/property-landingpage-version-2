---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/astro/ProjectCard.astro";
import ContactSection from "@/components/astro/ContactSection.astro";
import { projects } from "@/data/projects";
import { services } from "@/data/services";
import heroImg from "../assets/65b0f49b1e92fa1b084c96ce_hero-image.webp?url";
import serviceImg from "../assets/65bf46eb711565ace2c83bf7_service-overview-mobile-image.webp?url";
---
<BaseLayout title="Serenity in essentials" description="Von Falk creates authentic, sophisticated interiors with an appreciation for essential details.">
  <div class="vf-container">
    <section class="vf-hero" aria-labelledby="home-heading">
      <h1 class="vf-hero-heading" id="home-heading">Serenity in essentials.</h1>
      <div class="vf-hero-media">
        <img class="vf-image" src={heroImg} alt="Quiet living room with carefully selected furnishings" width="1800" height="1013" fetchpriority="high" decoding="async" />
      </div>
      <div class="vf-hero-bottom">
        <p>Designing minimal spaces embracing the value of every detail. We create authentic, sophisticated spaces to match your personality and daily routine.</p>
        <a class="vf-link" href="#featured-projects">Explore our work</a>
      </div>
    </section>

    <section class="vf-section reveal" id="featured-projects" aria-labelledby="projects-title">
      <div class="vf-projects-heading">
        <h2 class="vf-section-title" id="projects-title">Projects.</h2>
        <a class="vf-link" href="/projects">See all</a>
      </div>
      <div class="vf-project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section class="vf-section reveal" aria-labelledby="services-title">
      <h2 class="vf-section-title" id="services-title" style="margin-bottom:clamp(2rem,5vw,5rem)">Services.</h2>
      <div class="vf-services-overview">
        <div>
          <ol>
            {services.map((service, index) => (
              <li class="vf-service-row">
                <span><small>{String(index + 1).padStart(2, "0")}</small>{service.name}.</span>
              </li>
            ))}
          </ol>
          <a class="vf-link" style="margin-top:1.5rem" href="/services">Our services</a>
        </div>
        <div class="vf-service-photo-block">
          <img class="vf-services-photo" src={serviceImg} alt="Minimal living room with an olive-green sofa" loading="lazy" decoding="async" width="900" height="675" />
        </div>
      </div>
    </section>

    <ContactSection />
  </div>
</BaseLayout>
