---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="Serenity in essentials"><div class="padding-global px-[var(--spacing-gutter)] max-md:px-[var(--spacing-gutter-mobile)]"><div class="container-large mx-auto w-full max-w-[var(--container-vonfalk)]"><h1 class="text-[var(--text-hero)] max-md:text-[var(--text-hero-mobile)] font-serif">Serenity in essentials.</h1><p>Designing minimal spaces embracing the value of every detail.</p><h2 class="text-[var(--text-h2)] font-serif">Projects.</h2><h2 class="text-[var(--text-h2)] font-serif">Services.</h2><h2 class="text-[var(--text-h2)] font-serif">Get in touch.</h2></div></div></BaseLayout>
