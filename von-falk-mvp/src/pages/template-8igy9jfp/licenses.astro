---
import BaseLayout from "@/layouts/BaseLayout.astro";
import pexelsComposite from "../../assets/license/pexels-composite.webp?url";
import unsplashComposite from "../../assets/license/unsplash-composite.webp?url";

const imageSources = [
  {
    title: "Pexels",
    website: "https://www.pexels.com/",
    license: "https://www.pexels.com/license/",
    composite: pexelsComposite,
    compositeAlt: "Collage of six photographs credited to Pexels contributors",
    groups: [
    {
        "group": "Blog",
        "links": [
            "https://www.pexels.com/@kseniachernaya/",
            "https://www.pexels.com/@rachel-claire/"
        ]
    },
    {
        "group": "Services",
        "links": [
            "https://www.pexels.com/@kseniachernaya/",
            "https://www.pexels.com/@karolina-grabowska/",
            "https://www.pexels.com/@pixabay/",
            "https://www.pexels.com/@tima-miroshnichenko/",
            "https://www.pexels.com/@heyho/",
            "https://www.pexels.com/@roman-ska-3453281/"
        ]
    }
],
  },
  {
    title: "Unsplash",
    website: "https://unsplash.com/",
    license: "https://unsplash.com/license",
    composite: unsplashComposite,
    compositeAlt: "Collage of photographs credited to Unsplash contributors",
    groups: [
    {
        "group": "Static Von Falk pages",
        "links": [
            "https://unsplash.com/@jalgtvstand"
        ]
    },
    {
        "group": "Projects",
        "links": [
            "https://unsplash.com/@itsbilalmn",
            "https://unsplash.com/@deconovo"
        ]
    },
    {
        "group": "Blog",
        "links": [
            "https://unsplash.com/@mathildelangevin"
        ]
    },
    {
        "group": "Services",
        "links": [
            "https://unsplash.com/@juleskwak",
            "https://unsplash.com/@jipy32"
        ]
    },
    {
        "group": "Team",
        "links": [
            "https://unsplash.com/@olenkasergienko",
            "https://unsplash.com/@blakepnw",
            "https://unsplash.com/@zabegina"
        ]
    }
],
  },
];
---
<BaseLayout title="License" description="Credits and source licenses for images used on the Von Falk website.">
  <div class="vf-container vf-license-page">
    <div class="vf-license-content">
      <h1>License</h1>
      <p>All graphical assets in this template are licensed for personal and commercial use. If you'd like to use a specific asset, please check the license below.</p>
      {imageSources.map((source) => (
        <section class="vf-license-source" aria-label={source.title + " image credits"}>
          <h2>{source.title}</h2>
          <p>
            These photographs were sourced from <a href={source.website} target="_blank" rel="noopener noreferrer">{source.title}</a>.
            <a href={source.license} target="_blank" rel="noopener noreferrer">{source.title} license</a>.
          </p>
          <img src={source.composite} alt={source.compositeAlt} class="vf-license-composite" loading="lazy" decoding="async" />
          <p class="vf-license-credits-intro">Below are the profiles of the original image creators and/or publishers, grouped by the template pages where their work was used:</p>
          {source.groups.map((group) => (
            <div class="vf-license-credit-group">
              <h3>{group.group}:</h3>
              <ul>
                {group.links.map((url) => <li><a href={url} target="_blank" rel="noopener noreferrer">{url}</a></li>)}
              </ul>
            </div>
          ))}
        </section>
      ))}
      <p class="vf-license-note">Individual image licenses and third-party rights remain subject to the linked sources.</p>
    </div>
  </div>
</BaseLayout>
