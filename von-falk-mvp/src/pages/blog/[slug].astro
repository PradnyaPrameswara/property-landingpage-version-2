---
import BaseLayout from "@/layouts/BaseLayout.astro";
import dividerUrl from "../../assets/65e5c15136cb5752bdc91569_65afab2c82c75aa35f79f9c3_image.svg?url";
import { posts } from "@/data/blog";
export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props as { post: (typeof posts)[number] };
---
<BaseLayout title={post.title}><div class="padding-global px-[var(--spacing-gutter)] max-md:px-[var(--spacing-gutter-mobile)]"><div class="container-large mx-auto w-full max-w-[var(--container-vonfalk)]"><h1>{post.title}.</h1><img src={post.cover} alt={post.coverAlt} /><img src={dividerUrl} alt="" aria-hidden="true" /></div></div></BaseLayout>
