---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ReferenceRichText from "@/components/astro/ReferenceRichText.astro";
import { posts } from "@/data/blog";

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props as { post: (typeof posts)[number] };
---
<BaseLayout title={post.title} description={post.excerpt} image={post.cover}>
  <div class="vf-container vf-blog-detail-page">
    <section class="vf-blog-detail-columns" aria-labelledby="article-title">
      <div class="vf-blog-detail-text">
        <h1 class="vf-blog-detail-title" id="article-title">{post.title}.</h1>
        <article class="vf-blog-detail-copy">
          <ReferenceRichText variant="blog" />
        </article>
      </div>
      <div class="vf-blog-detail-media">
        <figure class="vf-blog-detail-cover">
          <img src={post.cover} alt={post.coverAlt} width="1000" height="760" loading="eager" decoding="sync" fetchpriority="high" />
        </figure>
        <div class="vf-blog-detail-extra">
          {post.images.map((src, index) => (
            <figure><img src={src} alt={"Interior detail illustrating " + post.title + ", image " + (index + 1)} width="1000" height="760" loading="eager" decoding="sync" /></figure>
          ))}
        </div>
      </div>
    </section>
    <div style="margin-top:clamp(3rem,6vw,7rem)"><a class="vf-link" href="/blog">Back to blog</a></div>
  </div>
</BaseLayout>
