---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { services } from "@/data/services";
---
<BaseLayout title="Services"><div class="padding-global px-[var(--spacing-gutter)] max-md:px-[var(--spacing-gutter-mobile)]"><div class="container-large mx-auto w-full max-w-[var(--container-vonfalk)]"><h1>Services</h1>{services.map((service, index) => (<div><span>{String(index + 1).padStart(2, "0")}</span><h2>{service.name}</h2><img src={service.image} alt={service.imageAlt} loading="lazy" /></div>))}</div></div></BaseLayout>
