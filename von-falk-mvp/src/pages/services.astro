---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { services } from "@/data/services";
const descriptions = [
  "A thoughtful spatial plan brings function and clarity together. We develop the layout and interior concept around how each space will be lived in.",
  "Visualising materials, proportions and light makes every design decision easier to understand before work begins.",
  "Furniture and carefully chosen objects give the space its personality, balancing comfort, form and the rhythms of everyday life.",
  "Art can define a room and connect its elements. We consider each piece in relation to the architecture, furniture and atmosphere.",
  "Light shapes materials and mood throughout the day. We bring functional and atmospheric lighting into one cohesive composition.",
  "A well-coordinated process keeps the design intent clear as a project moves through its different phases.",
  "The final selection and installation of individual pieces complete the interior and bring the original vision into focus.",
];
---
<BaseLayout title="Services" description="Interior design, spatial planning, furniture, art, lighting, project management and installation services.">
  <div class="vf-container">
    <header class="vf-intro"><h1 class="vf-page-title">Services.</h1></header>
    <div class="vf-editorial">
      {services.map((service, index) => (
        <section class="vf-editorial-row reveal" aria-labelledby={"service-" + index}>
          <div class="vf-editorial-media">
            <img src={service.image} alt={service.imageAlt} loading="lazy" decoding="async" width="900" height="1125" />
          </div>
          <div class="vf-editorial-text">
            <span class="vf-kicker" style="margin-bottom:1rem">{String(index + 1).padStart(2, "0")}</span>
            <h2 id={"service-" + index}>{service.name}.</h2>
            <p>{descriptions[index]}</p>
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
