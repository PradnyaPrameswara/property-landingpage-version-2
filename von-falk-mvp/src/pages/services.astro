---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { services } from "@/data/services";
const descriptions = [
  "A thoughtful spatial plan brings function and clarity together. We develop the layout and interior concept around how each space will be lived in, paying attention to circulation, natural light and the proportions of every room. Materials and furniture support the plan from the beginning.",
  "Visualising materials, proportions and light makes every design decision easier to understand before work begins. Three-dimensional views can reveal how surfaces, furniture and lighting relate to one another, allowing the design to be refined as a complete interior rather than as separate elements.",
  "Furniture and carefully chosen objects give the space its personality, balancing comfort, form and the rhythms of everyday life. We consider shape, scale, texture and placement together, so each object contributes to the atmosphere without overwhelming the room or interrupting how people move through it.",
  "Art can define a room and connect its elements. We consider each piece in relation to the architecture, furniture and atmosphere, from its size and position to the way it catches the light. The intention is to create an individual composition in which the artwork feels naturally connected to its surroundings.",
  "Light shapes materials and mood throughout the day. We bring functional and atmospheric lighting into one cohesive composition, considering how a room changes from morning to evening. A balance of daylight, task lighting and softer accents lets the interior work comfortably across different moments.",
  "A well-coordinated process keeps the design intent clear as a project moves through its different phases. Careful attention to information, finishes and timing helps each decision remain consistent with the original concept while keeping the practical needs of the people using the space in view.",
  "The final selection and installation of individual pieces complete the interior and bring the original vision into focus. We consider the relationship between furnishings, artworks and smaller details, so that the finished room feels cohesive, functional and personal rather than simply arranged.",
];
---
<BaseLayout title="Services" description="Interior design, spatial planning, furniture, art, lighting, project management and installation services.">
  <div class="vf-container vf-services-page">
    <header class="vf-intro"><h1 class="vf-page-title">Services.</h1></header>
    <div class="vf-editorial">
      {services.map((service, index) => (
        <section class="vf-editorial-row reveal" aria-labelledby={"service-" + index}>
          <div class="vf-editorial-media">
            <img src={service.image} alt={service.imageAlt} loading={index === 0 ? "eager" : "lazy"} decoding={index === 0 ? "sync" : "async"} fetchpriority={index === 0 ? "high" : "auto"} width="900" height="1125" />
          </div>
          <div class="vf-editorial-text">
            <span class="vf-kicker" style="margin-bottom:1rem">{String(index + 1).padStart(2, "0")}</span>
            <h2 id={"service-" + index}>{service.name}.</h2>
            <p>{descriptions[index]}</p>
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
