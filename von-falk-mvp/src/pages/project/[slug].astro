---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projects } from "@/data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props as { project: (typeof projects)[number] };
---
<BaseLayout title={project.title} description={"An interior project in " + project.city + " by Von Falk."} image={project.cover}>
  <div class="vf-container vf-project-detail-page">
    <section class="vf-project-intro" aria-labelledby="project-title">
      <div class="vf-project-intro-content">
        <h1 class="vf-project-title" id="project-title">{project.title}.</h1>
        <div class="vf-project-story">
          <h2>Interior study.</h2>
          <p>This project is part of the Von Falk portfolio. The selected photographs explore the relationship between interior architecture, furnishings, lighting and the way that materials work together.</p>
          <p>Each view places attention on the details that make up the interior. From larger architectural elements to smaller pieces, these images document the choices that contribute to the overall composition.</p>
        </div>
      </div>
      <aside class="vf-project-aside" aria-label="Project information">
        <h2>Services</h2>
        <ul>{project.services.map((service) => <li>{service}.</li>)}</ul>
        <div class="vf-project-desktop-meta">
          <h2>Project information</h2>
          <p>{project.city}.</p>
          <p>{project.year}</p>
        </div>
        <details class="vf-project-mobile-details">
          <summary>More details <span aria-hidden="true">●</span></summary>
          <p>{project.city}. {project.year}.</p>
        </details>
      </aside>
    </section>
    <section class="vf-project-gallery" aria-label={"Photographs of " + project.title}>
      {project.images.map((photo, index) => (
        <figure>
          <img src={photo.src} alt={photo.alt} loading={index < 3 ? "eager" : "lazy"} decoding={index < 3 ? "sync" : "async"} width="900" height="700" />
        </figure>
      ))}
    </section>
    <a href="/projects" class="vf-link" style="margin-top:3rem">Back to projects</a>
  </div>
</BaseLayout>
