---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { team } from "@/data/team";
---
<BaseLayout title="Team" description="Meet the people behind Von Falk interior design studio.">
  <div class="vf-container vf-team-page">
    <header class="vf-intro"><h1 class="vf-page-title">Team.</h1></header>
    <section class="vf-team-section" aria-label="The Von Falk team">
      <div class="vf-team-grid">
        {team.map((member, index) => (
          <article class="vf-team-card" data-index={index}>
            <img src={member.image} alt={member.imageAlt} loading="eager" decoding="sync" width="900" height="900" />
            <h2>{member.name}</h2>
            <p>{member.role}.</p>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
