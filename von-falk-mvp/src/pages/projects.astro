---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/astro/ProjectCard.astro";
import { projects } from "@/data/projects";
---
<BaseLayout title="Projects" description="Selected interiors and projects from Von Falk.">
  <div class="vf-container">
    <header class="vf-intro"><h1 class="vf-page-title">Projects.</h1></header>
    <section class="vf-section" aria-label="Selected projects">
      <div class="vf-project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  </div>
</BaseLayout>
