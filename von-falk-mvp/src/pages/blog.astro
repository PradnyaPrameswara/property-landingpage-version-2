---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { posts } from "@/data/blog";
---
<BaseLayout title="Blog">
  <div class="padding-global px-[var(--spacing-gutter)] max-md:px-[var(--spacing-gutter-mobile)]">
    <div class="container-large mx-auto w-full max-w-[var(--container-vonfalk)]">
      <h1>Blog.</h1>
      {posts.map(post => (
        <a href={`/blog/${post.slug}`}>
          <img src={post.cover} alt={post.coverAlt} />
          <h2>{post.title}</h2>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
