---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { posts } from "@/data/blog";
---
<BaseLayout title="Blog" description="Stories, materials and perspectives from Von Falk.">
  <div class="vf-container">
    <header class="vf-intro"><h1 class="vf-page-title">Blog.</h1></header>
    <section class="vf-editorial" aria-label="Journal articles">
      {posts.map((post) => (
        <article class="vf-editorial-row reveal">
          <a href={"/blog/" + post.slug} class="vf-editorial-media" aria-label={"Read " + post.title}>
            <img src={post.cover} alt={post.coverAlt} loading="lazy" decoding="async" width="900" height="1125" />
          </a>
          <div class="vf-editorial-text">
            <h2><a href={"/blog/" + post.slug}>{post.title}.</a></h2>
            <p>{post.excerpt}</p>
            <a class="vf-link" href={"/blog/" + post.slug} style="margin-top:1.5rem">Read post</a>
          </div>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>
