---
import BaseLayout from "@/layouts/BaseLayout.astro";
import sec1 from "../assets/65b0f4a4699fd26fc8fba64a_section-image-1.webp?url";
import heroImg from "../assets/65b0f49b1e92fa1b084c96ce_hero-image.webp?url";
import touchImg from "../assets/65b0f49b13cc3a2dcfd5424e_get-in-touch-image.webp?url";
import sec4 from "../assets/65b0f4a65d1a48463fa34380_section-image-4.webp?url";
---
<BaseLayout title="About Us"><div class="padding-global px-[var(--spacing-gutter)] max-md:px-[var(--spacing-gutter-mobile)]"><div class="container-large mx-auto w-full max-w-[var(--container-vonfalk)]"><h1>About Us.</h1><img src={sec1} alt="Von Falk studio interior detail" /><h2>Concept.</h2><h2>Inspiration.</h2><img src={heroImg} alt="Minimal living room interior designed by Von Falk" /><h2>Approach.</h2><img src={sec4} alt="Von Falk studio interior detail" /><h2>Process.</h2><img src={touchImg} alt="Interior detail, contact Von Falk" /></div></div></BaseLayout>
